{
  "name": "honeytongue",
  "version": "0.1.0-alpha.8",
  "description": "Characters players can actually argue with: a persuasion mechanic for games where players type or speak to NPCs, judged by each character's own values. Powered by Jev.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbrought/honeytongue.git"
  },
  "homepage": "https://honeytongue.dev/",
  "bugs": {
    "url": "https://github.com/tbrought/honeytongue/issues"
  },
  "author": "Tristan Broughton (https://honeytongue.dev)",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./persuasion": {
      "types": "./src/persuasion.d.ts",
      "default": "./src/persuasion.js"
    },
    "./proxy": {
      "types": "./src/proxy.d.ts",
      "default": "./src/proxy.js"
    }
  },
  "bin": {
    "honeytongue": "src/cli.js"
  },
  "scripts": {
    "play": "node src/cli.js --debug",
    "play:mock": "node src/cli.js --mock --debug",
    "eval": "node scripts/eval.js",
    "example": "node examples/standalone.js",
    "test": "node --test",
    "proxy": "node examples/node-proxy.js",
    "playground": "node src/cli.js playground",
    "build:demo": "node scripts/build-demo.js",
    "typecheck": "node node_modules/typescript/bin/tsc -p typetest",
    "typecheck:oldest": "node node_modules/typescript-5/bin/tsc -p typetest",
    "check:package": "node scripts/check-package.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "persuasion",
    "npc",
    "npc-dialogue",
    "dialogue",
    "dialogue-system",
    "game-mechanics",
    "gamedev",
    "rpg",
    "charisma",
    "text-adventure",
    "text-game",
    "interactive-fiction",
    "twine",
    "sugarcube",
    "browser-game",
    "phaser",
    "ai-npc",
    "game-ai",
    "jev"
  ],
  "license": "MIT",
  "types": "src/index.d.ts",
  "files": [
    "src",
    "stories",
    "examples",
    "docs/playground",
    "docs/assets/fonts",
    "docs/style.css",
    "docs/theme.js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "devDependencies": {
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
